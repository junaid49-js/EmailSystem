PORT=3000

DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=email_system

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=SuperAdmin@1234

# ==========================================
# SMTP / NODEMAILER CONFIGURATION
# ==========================================
# Basic Server Settings (or use SMTP_SERVICE=gmail, mailgun, sendgrid, etc.)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_SERVICE=gmail

# Sender & Reply-To Identities
SMTP_FROM_NAME="Email System"
SMTP_FROM_EMAIL="no-reply@emailsystem.com"
SMTP_REPLY_TO="support@emailsystem.com"
EMAIL_FROM="Email System <no-reply@emailsystem.com>"

# Security & TLS
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_CIPHERS=

# Connection Pooling & High Volume
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Rate Limiting (e.g. 5 emails per second)
SMTP_RATE_LIMIT=5
SMTP_RATE_DELTA=1000

# Timeouts (in milliseconds)
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000

# Debugging (set to true to see full SMTP handshake protocol in console)
SMTP_DEBUG=false
SMTP_LOGGER=false
